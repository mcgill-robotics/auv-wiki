# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file — it is ignored by .gitignore.

# S/4HANA connection
S4_BASE_URL=https://my423259-api.s4hana.cloud.sap
S4_USER=POSTMAN_USER
S4_PASS=your_communication_user_password

# Anthropic API
# Get a key at console.anthropic.com -> Settings -> API Keys -> Create Key
ANTHROPIC_API_KEY=sk-ant-api03-...
